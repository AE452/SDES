 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "d"}], ")"}], " ", "s"}], "+", 
     RowBox[{"d", " ", 
      SuperscriptBox["epsilon", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"s", "+", "t"}], ")"}]}], "+", 
     RowBox[{"epsilon", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "r"}], "+", "s", "-", 
        RowBox[{"3", " ", "d", " ", "s"}], "+", "t", "-", 
        RowBox[{"d", " ", "t"}]}], ")"}]}]}], "==", 
