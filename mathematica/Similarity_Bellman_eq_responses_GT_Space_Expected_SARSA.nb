 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Make", " ", "a", " ", "grid", " ", "with", " ", "the", " ", "different", " ",
     "graphs", " ", 
    RowBox[{"(", 
     RowBox[{"as", " ", "square", " ", "as", " ", "possible"}], ")"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"grid", " ", "=", " ", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Graphics", "[", 
          RowBox[{"GraphPlot", "[", 
           RowBox[{
            RowBox[{"edgeslist", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
            RowBox[{"VertexLabels", "\[Rule]", 
             RowBox[{"Placed", "[", 
              RowBox[{"Automatic", ",", "Center"}], "]"}]}], ",", 
            RowBox[{"VertexSize", "->", ".3"}], ",", "  ", 
            RowBox[{"DirectedEdges", "\[Rule]", "True"}], ",", 
            RowBox[{"PlotLabel", "\[Rule]", "i"}], ",", 
            RowBox[{"PlotStyle", "\[Rule]", "Thick"}], ",", " ", 
            RowBox[{
            "GraphLayout", "\[Rule]", "\"\<LayeredDigraphEmbedding\>\""}]}], 
           "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "edgeslist", "]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Ceiling", "[", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Length", "[", "Graphs", "]"}], "]"}], "]"}], ",", 
         RowBox[{"Ceiling", "[", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Length", "[", "Graphs", "]"}], "]"}], "]"}]}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Convert", " ", "the", " ", "zeroes", " ", "on", " ", "the", " ", "empty",
      " ", "spaces", " ", "in", " ", "the", " ", "grid", " ", "to", " ", 
     "empty", " ", "graphics"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"grid", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"[", "j", "]"}], "]"}], "==", "0"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"grid", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"[", "j", "]"}], "]"}], " ", "=", " ", 
          RowBox[{"Graphics", "[", 
           RowBox[{"{", "}"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"grid", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "grid", "]"}]}], "}"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Delete", " ", "the", " ", "empty", " ", "rows"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"grid", "[", 
         RowBox[{"[", "i", "]"}], "]"}], " ", "==", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"{", "}"}], "]"}], ",", 
          RowBox[{"Length", "[", 
           RowBox[{"grid", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"grid", " ", "=", " ", 
         RowBox[{"grid", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", 
            RowBox[{"i", "-", "1"}]}], "]"}], "]"}]}], ";", " ", 
        RowBox[{"Break", "[", "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "grid", "]"}]}], "}"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Draw", " ", "the", " ", "grid"}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{"GraphicsGrid", "[", 
    RowBox[{"grid", ",", 
     RowBox[{"Frame", "\[Rule]", "All"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "Full"}]}], "]"}]}]}]], "Input",
