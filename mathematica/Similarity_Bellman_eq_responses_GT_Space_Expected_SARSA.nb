Cell["\<\
Phase diagram and IBR graphs for the Prisoner\[CloseCurlyQuote]s Dilemma \
using the state space {CC} ,{DD, DC, CD}\
\>", "Title",
 CellChangeTimes->{{3.929694700436885*^9, 
  3.9296947364100733`*^9}},ExpressionUUID->"0762173a-740c-4623-8a1e-\
4aa6a9359e0f"],

