 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"d", "\[Rule]", 
    FractionBox[
     RowBox[{
      RowBox[{"2", " ", "p"}], "-", 
      RowBox[{"epsilon", " ", "p"}], "-", 
      RowBox[{"epsilon", " ", "r"}], "-", 
