Cell["\<\
Next we check which best-response relationships can hold simultaneously. This \
splits the parameter space into regions where each region corresponds to one \
IBR graph. Here the strategy GT is labeled by a 3 and the AD strategy is \
labeled by a 1. A self-loop at a node implies that it is an equilibrium. \
\>", "Text",
 CellChangeTimes->{{3.92969496348551*^9, 3.92969501050205*^9}, {
  3.9296951215222397`*^9, 
  3.929695166616053*^9}},ExpressionUUID->"43f248c2-2cab-49c7-ab76-\
09815ced794a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Find", " ", "the", " ", "actual", " ", "possible", " ", "graphs", " ", 
    "by", " ", "adding", " ", "a", " ", "restriction", " ", "one", " ", "at", 
    " ", "the", " ", "time", " ", "if", " ", "it", " ", "does", " ", "not", " ",
     "yield", " ", "an", " ", "empty", " ", "region"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Here", " ", "will", " ", "will", " ", "get", " ", "all", " ", "graphs", " ",
     "and", " ", "their", " ", "regions"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "We", " ", "will", " ", "initialise", " ", "with", " ", "the", " ", 
    "transitions", " ", "from", " ", "0", " ", "and", " ", "their", " ", 
    "regions"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"possible", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"transitions", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", 
           RowBox[{"[", "j", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"transitions", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", 
           RowBox[{"[", "j", "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"transitions", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Updated", " ", "possible", " ", "after", " ", "adding", " ", "the", " ",
        "next", " ", "round", " ", "of", " ", "transitions"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"next", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Do", "[", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Add", " ", "a", " ", "new", " ", "transition", " ", "to", " ", 
             RowBox[{"possible", "[", 
              RowBox[{"[", "k", "]"}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"function", " ", "=", " ", 
              RowBox[{"Assuming", "[", 
               RowBox[{"restrictions", ",", 
                RowBox[{"FullSimplify", "[", 
                 RowBox[{"And", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"possible", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"transitions", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}]}], "]"}]}],
              ";", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{
               "If", " ", "the", " ", "new", " ", "region", " ", "is", " ", 
                "non", " ", "empty"}], ",", " ", 
               RowBox[{"add", " ", 
                RowBox[{"possible", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], " ", "with", " ", "the", " ",
                 "new", " ", "transition", " ", "to", " ", "next"}]}], "*)"}],
              "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"function", "===", "False"}], ")"}], "==", "False"}],
                ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"next", " ", "=", " ", 
                 RowBox[{"AppendTo", "[", 
                  RowBox[{"next", ",", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Flatten", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"possible", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"transitions", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "]"}], ",", 
                    RowBox[{"Assuming", "[", 
                    RowBox[{"restrictions", ",", 
                    RowBox[{"FullSimplify", "[", 
                    RowBox[{"And", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"possible", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", "function"}], "]"}], 
                    "]"}]}], "]"}]}], "}"}]}], "]"}]}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", 
              RowBox[{"Length", "[", "possible", "]"}]}], "}"}]}], "]"}], 
          ";"}], "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"transitions", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"possible", " ", "=", " ", "next"}], ";"}], 
      "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2", ",", "4"}], "}"}]}], "]"}], ";"}], "        ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Add", " ", "the", " ", "restrictions"}], "*)"}], "\[IndentingNewLine]", 
