Cell["\<\
By plotting both of the conditions, we see that only the first is relevant. \
For the second condition, we have\
\>", "Text",
 CellChangeTimes->{{3.981692454931308*^9, 
  3.981692482542965*^9}},ExpressionUUID->"8e45fb51-1ef6-4438-8479-\
e56bc9d369e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"epsilon", " ", 
     RowBox[{"(", 
      RowBox[{"p", "+", "r", "-", "s", "-", "t"}], ")"}]}], "+", 
    RowBox[{"2", " ", "t"}], "+", 
    RowBox[{"d", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "epsilon"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "epsilon"}], ")"}], " ", "p"}], "+", 
       RowBox[{"2", " ", "t"}], "-", 
       RowBox[{"epsilon", " ", 
        RowBox[{"(", 
         RowBox[{"s", "+", "t"}], ")"}]}]}], ")"}]}]}], "<", 
   RowBox[{"2", " ", "r"}]}], "&&", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "2"}], "+", 
       RowBox[{"2", " ", "d", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "epsilon"}], ")"}], "2"]}], "+", 
       "epsilon"}], ")"}], " ", "p"}], "+", 
    RowBox[{"epsilon", " ", 
     RowBox[{"(", 
      RowBox[{"r", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"3", " ", "d"}]}], ")"}], " ", "s"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "d"}], ")"}], " ", "t"}]}], ")"}]}]}], "<", 
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "d"}], ")"}], " ", "s"}], "+", 
    RowBox[{"d", " ", 
     SuperscriptBox["epsilon", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"s", "+", "t"}], ")"}]}]}]}]}]], "Input",ExpressionUUID->\
"44e0300f-b02a-4acf-95cb-eb9890644cad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "+", 
        RowBox[{"2", " ", "d", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "epsilon"}], ")"}], "2"]}], "+", 
        "epsilon"}], ")"}], " ", "p"}], "+", 
     RowBox[{"epsilon", " ", 
      RowBox[{"(", 
       RowBox[{"r", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           RowBox[{"3", " ", "d"}]}], ")"}], " ", "s"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "d"}], ")"}], " ", "t"}]}], ")"}]}]}], "==", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "d"}], ")"}], " ", "s"}], "+", 
     RowBox[{"d", " ", 
      SuperscriptBox["epsilon", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"s", "+", "t"}], ")"}]}]}]}], ",", " ", "d"}], "]"}]], "Input",\

 CellChangeTimes->{{3.981692502577868*^9, 3.981692526691696*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"feea1693-6f55-4e10-ae0f-a2745e820469"],

